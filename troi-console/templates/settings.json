{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "printf thinking > __ROOT__/barehands/state/state"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "printf idle > __ROOT__/barehands/state/state"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 __ROOT__/troi-console/guard.py"
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 __ROOT__/troi-console/guard.py"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 __ROOT__/troi-console/guard.py"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(rm:*)",
      "Bash(rmdir:*)",
      "Bash(sudo rm:*)",
      "Bash(git clean:*)",
      "Bash(git reset --hard:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(kubectl delete:*)"
    ],
    "allow": [
      "Bash(__ROOT__/troi-console/*)",
      "Read(/__VAULT__/**)",
      "Edit(/__VAULT__/**)"
    ],
    "additionalDirectories": [
      "__VAULT__"
    ]
  },
  "enableAllProjectMcpServers": true
}